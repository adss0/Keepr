{
  "name": "keepr-desktop",
  "productName": "Keepr",
  "version": "1.0.0",
  "description": "You keep your receipts. Keepr keeps your rights.",
  "author": "adss0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.adss0.keepr.desktop",
    "productName": "Keepr",
    "files": ["main.js", "offline.html", "icon.png"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keepr"
    }
  }
}
